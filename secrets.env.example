# AI Provider API Keys
# Get your Groq key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: additional Groq keys for rate-limit failover. Each key should come
# from a SEPARATE Groq account (e.g. a different Gmail) so it has its own quota;
# multiple keys from the same account share one limit and won't help.
# They are tried in order (GROQ_API_KEY -> GROQ_API_KEY_2 -> GROQ_API_KEY_3 ...)
# before falling back to Gemini. Up to GROQ_API_KEY_10 is supported.
# GROQ_API_KEY_2=your_second_groq_api_key_here

# Optional: override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Get your Gemini key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-flash-lite-latest)
# Note: pinned versions like gemini-2.0-flash / gemini-2.5-flash have been
# retired and now return HTTP 404. The *-latest aliases track current models.
# gemini-flash-lite-latest is fast and reliably returns text; the thinking
# "gemini-flash-latest" model can return empty responses under tight budgets.
# GEMINI_MODEL=gemini-flash-lite-latest

{
  "name": "ai-diagram-document-generator",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered tool for generating diagrams-as-code and structured technical documents from natural language prompts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "concurrently \"tsx watch src/index.ts\" \"pnpm --dir frontend dev -- --host\"",
    "dev:frontend": "pnpm --dir frontend dev",
    "build": "tsc && pnpm build:frontend",
    "build:frontend": "pnpm --dir frontend install && pnpm --dir frontend build",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:property": "vitest run tests/property",
    "test:integration": "vitest run tests/integration"
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@upstash/redis": "^1.38.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.6.0",
    "markdown-it": "^15.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "@vercel/node": "^5.8.26",
    "concurrently": "10.0.5",
    "fast-check": "^4.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@9.1.0"
}

# AI Backend API Keys
# Copy this file to secrets.env and fill in your actual API keys

# Groq API Key (primary AI backend - fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the Groq model (default: openai/gpt-oss-120b)
# GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (secondary/fallback AI backend)
GEMINI_API_KEY=your_gemini_api_key_here
